# =====================================================================
# Pivot Pilot — Environment Configuration Template
# =====================================================================
# Copy this file to .env in the project root or backend directory to 
# configure live LLM providers.
#
# If neither key is provided, Pivot Pilot seamlessly runs in its
# deterministic demo fallback mode with complete offline fidelity.
#
# NEVER COMMIT YOUR REAL .env FILE OR EXPOSE API KEYS.
# =====================================================================

# Preferred: Google Gemini API Key
GEMINI_API_KEY=

# Alternative: Google API Key format
GOOGLE_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000

